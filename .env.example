# Project name used to namespace containers, network, and volumes.
# Lets you run multiple WP environments on the same machine without clashes.
# Defaults to the current directory name (e.g. `wp-dev-environment`).
# Override here if you want a custom prefix.
PROJECT_NAME=wp-dev-environment

DOMAIN=web.local
PORT=8081
PHPMYADMIN_PORT=8082

# Database Configuration for Docker Compose
DATABASENAME=databasename
DATABASEUSER=databaseuser
DATABASEPASS=databasepass
MYSQL_ROOT_PASSWORD=r00tP@ssw0rd

